@page
@{
    ViewData["Title"] = "Cash Flow by Category";
}

<div id="app" v-cloak>
    <div class="row mb-3">
        <div class="col-12">
            <h3 class="mb-0">Cash Flow by Category</h3>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4 mb-2">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">Total Received</div>
                    <h4 id="TotalReceiptValue" class="mb-0 text-success">{{ state.summary.receiptText }}</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-2">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">Total Spent</div>
                    <h4 id="TotalExpenseValue" class="mb-0 text-danger">{{ state.summary.expenseText }}</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-2">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">Net Cash Flow</div>
                    <h4 id="NetCashFlowValue" class="mb-0">{{ state.summary.netText }}</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-2">
                            <label for="FromDatePicker">From Date</label>
                            <input id="FromDatePicker" ref="fromDateRef" />
                        </div>
                        <div class="col-md-3 mb-2">
                            <label for="ToDatePicker">To Date</label>
                            <input id="ToDatePicker" ref="toDateRef" />
                        </div>
                        <div class="col-md-4 mb-2">
                            <label for="CashAccountDropDown">Cash Account</label>
                            <div id="CashAccountDropDown" ref="cashAccountRef"></div>
                        </div>
                        <div class="col-md-2 mb-2 d-flex align-items-end">
                            <button type="button" class="btn btn-secondary w-100" v-on:click="handler.handleClearFilters">Clear Filters</button>
                        </div>
                    </div>
                    <div class="text-muted small">Only actual payments are included. Internal fund transfers are excluded.</div>
                    <div v-if="state.error" class="alert alert-warning mt-3 mb-0">
                        <span>{{ state.error }}</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary ms-2" v-on:click="handler.handleRetry">Retry</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div id="MainGrid" ref="mainGridRef"></div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/CashTransactions/CashCategoryReport.cshtml.js" asp-append-version="true"></script>
}
