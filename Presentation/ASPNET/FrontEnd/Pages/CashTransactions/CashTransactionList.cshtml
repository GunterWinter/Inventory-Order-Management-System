@page
@{
    ViewData["Title"] = "Cash Transaction List";
}

<style>
    .allocation-panel {
        overflow: hidden;
        border: 1px solid #dbe3ec;
        border-radius: 0.75rem;
        background: #f8fafc;
        box-shadow: 0 0.125rem 0.375rem rgba(31, 45, 61, 0.06);
    }

    .allocation-panel__header {
        padding: 0.875rem 1rem;
        border-bottom: 1px solid #e4e9f0;
        background: #fff;
    }

    .allocation-panel__body {
        padding: 0.875rem 1rem 0.5rem;
    }

    .allocation-row {
        padding: 0.75rem;
        border: 1px solid #e2e8f0;
        border-radius: 0.625rem;
        background: #fff;
    }

    .allocation-row + .allocation-row {
        margin-top: 0.625rem;
    }

    .allocation-row .form-control {
        min-height: 38px;
    }

    .allocation-remove-button {
        width: 38px;
        height: 38px;
        padding: 0;
        border-radius: 0.5rem;
    }

    .allocation-panel__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        border-top: 1px solid #e4e9f0;
        background: #fff;
    }

    .allocation-total {
        padding: 0.35rem 0.65rem;
        border-radius: 999px;
        background: #edf2f7;
        font-weight: 600;
        white-space: nowrap;
    }

    .allocation-total.text-danger {
        background: #fff0f1;
    }

    @@media (max-width: 767.98px) {
        .allocation-panel__footer {
            align-items: flex-start;
            flex-direction: column;
        }

        .allocation-total {
            white-space: normal;
        }
    }
</style>

<div id="app" v-cloak>
    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div id="MainGrid" ref="mainGridRef"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="mainModalRef" id="MainModal" aria-hidden="true" tabindex="-1" data-bs-focus="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ state.mainTitle }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div v-if="state.sourceModule && methods.isEditableSource() && !state.viewMode && !state.deleteMode"
                         class="alert alert-info py-2">
                        {{ state.sourceModule === 'MaterialExport'
                            ? 'Only Description and Cash Category can be edited for a material export transaction.'
                            : 'Only Paid Amount, Description and Cash Category can be edited for a source-generated transaction.' }}
                    </div>
                    <input type="hidden" v-model="state.id" id="Id" name="Id" />
                    <form id="MainForm">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Transaction Info</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="TransactionDate">Transaction Date</label>
                                                <input id="TransactionDatePicker" ref="transactionDateRef" />
                                                <label class="text-danger">{{ state.errors.transactionDate }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="TransactionType">Transaction Type</label>
                                                <div id="TransactionTypeDropDown" ref="transactionTypeRef"></div>
                                                <label class="text-danger">{{ state.errors.transactionType }}</label>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="CashAccount">Cash Account</label>
                                                <div id="CashAccountDropDown" ref="cashAccountRef"></div>
                                                <label class="text-danger">{{ state.errors.cashAccountId }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="CashCategory">Cash Category</label>
                                                <div id="CashCategoryDropDown" ref="cashCategoryRef"></div>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="Partner">Partner</label>
                                                <div id="PartnerDropDown" ref="partnerRef"></div>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="Amount">Amount</label>
                                                <input id="AmountInput" ref="amountRef">
                                                <label class="text-danger">{{ state.errors.amount }}</label>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="PaidAmount">Paid Amount</label>
                                                <input id="PaidAmountInput" ref="paidAmountRef">
                                                <label class="text-danger">{{ state.errors.paidAmount }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label>Status</label>
                                                <div class="form-control-plaintext">
                                                    <span v-if="state.paidAmount >= state.amount && state.amount > 0" class="badge bg-success">Paid</span>
                                                    <span v-else-if="state.paidAmount > 0" class="badge bg-warning text-dark">Partially Paid</span>
                                                    <span v-else class="badge bg-secondary">Unpaid</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-12">
                                                <label for="Description">Description</label>
                                                <textarea v-model="state.description" id="Description" name="Description" class="form-control" rows="3"
                                                          v-bind:disabled="!methods.canEditRestrictedFields()"></textarea>
                                            </div>
                                        </div>
                                        <div v-if="methods.canShowAllocationToggle()" class="d-flex justify-content-end mb-2">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" v-on:click="methods.toggleAllocationDetails()">
                                                {{ state.showAllocationDetails ? 'Ẩn chi tiết phân bổ' : 'Chi tiết phân bổ' }}
                                            </button>
                                        </div>
                                        <div v-if="methods.shouldShowAllocationPanel()" class="allocation-panel mb-2">
                                            <div class="allocation-panel__header d-flex justify-content-between align-items-center">
                                                <strong><i class="fas fa-project-diagram text-primary mr-2"></i>Chi tiết phân bổ</strong>
                                                <button type="button" class="btn btn-sm btn-outline-primary" v-on:click="methods.addAllocation()" v-bind:disabled="!methods.canEditPrimaryFields()">
                                                    <i class="fas fa-plus mr-1"></i>Thêm dòng
                                                </button>
                                            </div>
                                            <div class="allocation-panel__body">
                                                <div v-if="state.allocationRows.length === 0" class="text-center text-muted py-3">
                                                    Chưa có dòng phân bổ. Bấm “Thêm dòng” để phân bổ theo khách hàng hoặc công trình.
                                                </div>
                                                <div v-for="(row, index) in state.allocationRows" v-bind:key="index" class="allocation-row row align-items-end mx-0">
                                                    <div class="col-md-4 px-1 mb-2 mb-md-0">
                                                        <label class="small font-weight-semibold text-muted mb-1">Khách hàng / Công trình</label>
                                                        <select class="form-control" data-searchable-dropdown v-bind:value="row.customerId || ''" v-on:change="row.customerId = $event.target.value || null" v-bind:disabled="!methods.canEditPrimaryFields()">
                                                            <option value="">Chọn khách hàng / công trình</option>
                                                            <option v-for="c in state.partnerList.filter(p => p.customerId)" v-bind:key="c.customerId" v-bind:value="c.customerId">{{ c.name }}</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-md-3 px-1 mb-2 mb-md-0">
                                                        <label class="small font-weight-semibold text-muted mb-1">Số tiền</label>
                                                        <input type="number" min="0" class="form-control" v-model.number="row.amount" v-on:input="methods.onAllocationAmountInput()" placeholder="Nhập số tiền" v-bind:disabled="!methods.canEditPrimaryFields()" />
                                                    </div>
                                                    <div class="col px-1 mb-2 mb-md-0">
                                                        <label class="small font-weight-semibold text-muted mb-1">Diễn giải</label>
                                                        <input class="form-control" v-model="row.description" placeholder="Nhập diễn giải" v-bind:disabled="!methods.canEditPrimaryFields()" />
                                                    </div>
                                                    <div class="col-auto px-1">
                                                        <button type="button" class="btn btn-outline-danger allocation-remove-button" title="Xóa dòng phân bổ" v-on:click="methods.removeAllocation(index)" v-bind:disabled="!methods.canEditPrimaryFields()">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="allocation-panel__footer">
                                                <span class="small text-muted">Tổng các dòng phải bằng tổng tiền giao dịch khi có phân bổ.</span>
                                                <span class="allocation-total" v-bind:class="{ 'text-danger': !methods.validateAllocations(), 'text-success': methods.validateAllocations() }">
                                                    Tổng phân bổ: {{ methods.formatMoney(methods.allocationTotal()) }} / {{ methods.formatMoney(state.amount) }}
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="card mt-3" v-if="methods.shouldShowGoodsPanel()">
                                    <div class="card-header"><h5>Hàng hóa</h5></div>
                                    <div class="card-body table-responsive">
                                        <div v-if="state.sourceDetailsLoading" class="text-center text-muted py-3">Đang tải chi tiết hàng hóa...</div>
                                        <div v-else-if="state.sourceDetailsError" class="alert alert-danger mb-2">{{ state.sourceDetailsError }}</div>
                                        <table v-else class="table table-sm table-bordered mb-0 source-goods-table">
                                            <thead><tr><th>Hàng hóa</th><th>Khách hàng</th><th>Kho</th><th class="text-end">Số lượng</th><th class="text-end">Đơn giá</th><th class="text-end">Thành tiền</th><th>Serial</th></tr></thead>
                                            <tbody>
                                                <tr v-for="item in state.allocationDetails" v-bind:key="`${item.productName}-${item.customerName}-${item.warehouseName}`">
                                                    <td>{{ item.productName }}</td><td>{{ item.customerName || '—' }}</td><td>{{ item.warehouseName || '—' }}</td>
                                                    <td class="text-end">{{ methods.formatNumber(item.quantity) }}</td><td class="text-end">{{ methods.formatMoney(item.unitPrice) }}</td><td class="text-end">{{ methods.formatMoney(item.total) }}</td><td>{{ item.productSerialNumbers || '—' }}</td>
                                                </tr>
                                                <tr v-if="state.allocationDetails.length === 0"><td colspan="7" class="text-center text-danger">Dữ liệu chứng từ nguồn không có dòng hàng hóa. Vui lòng kiểm tra lại chứng từ nguồn.</td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="card mt-3" v-if="state.paymentHistory.length > 0">
                                    <div class="card-header"><h5>Lịch sử thanh toán</h5></div>
                                    <div class="card-body table-responsive">
                                        <table class="table table-sm table-bordered mb-0">
                                            <thead><tr><th>Ngày thanh toán</th><th>Tài khoản quỹ</th><th class="text-end">Số tiền</th><th>Diễn giải</th></tr></thead>
                                            <tbody>
                                                <tr v-for="payment in state.paymentHistory" v-bind:key="payment.id">
                                                    <td>{{ methods.formatDate(payment.paymentDate) }}</td><td>{{ payment.cashAccountName }}</td><td class="text-end">{{ methods.formatMoney(payment.amount) }}</td><td>{{ payment.description }}</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button v-if="!state.viewMode" type="button"
                            id="MainSaveButton"
                            class="btn"
                            v-bind:class="state.deleteMode ? 'btn-danger' : 'btn-primary'"
                            v-on:click="handler.handleSubmit"
                            v-bind:disabled="state.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting" role="status" aria-hidden="true"></span>
                        <span v-if="!state.isSubmitting">{{ state.deleteMode ? 'Delete' : 'Save' }}</span>
                        <span v-else>{{ state.deleteMode ? 'Deleting...' : 'Saving...' }}</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="transferModalRef" id="TransferModal" aria-hidden="true" tabindex="-1" data-bs-focus="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Fund Transfer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="TransferForm">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Transfer Info</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="TransferDate">Transfer Date</label>
                                                <input id="TransferDatePicker" ref="transferDateRef" />
                                                <label class="text-danger">{{ state.transfer.errors.transferDate }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="TransferAmount">Amount</label>
                                                <input ref="transferAmountRef">
                                                <label class="text-danger">{{ state.transfer.errors.amount }}</label>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="FromAccount">From Account</label>
                                                <div id="FromAccountDropDown" ref="fromAccountRef"></div>
                                                <label class="text-danger">{{ state.transfer.errors.fromCashAccountId }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="ToAccount">To Account</label>
                                                <div id="ToAccountDropDown" ref="toAccountRef"></div>
                                                <label class="text-danger">{{ state.transfer.errors.toCashAccountId }}</label>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-12">
                                                <label for="TransferDescription">Description</label>
                                                <textarea v-model="state.transfer.description" id="TransferDescription" name="TransferDescription" class="form-control" rows="3"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button"
                            id="TransferSaveButton"
                            class="btn btn-primary"
                            v-on:click="handler.handleTransferSubmit"
                            v-bind:disabled="state.transfer.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.transfer.isSubmitting" role="status" aria-hidden="true"></span>
                        <span v-if="!state.transfer.isSubmitting">Save</span>
                        <span v-else>Saving...</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/CashTransactions/CashTransactionList.cshtml.js" asp-append-version="true"></script>
}
