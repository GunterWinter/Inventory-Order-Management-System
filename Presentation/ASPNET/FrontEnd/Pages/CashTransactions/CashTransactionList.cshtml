@page
@{
    ViewData["Title"] = "Cash Transaction List";
}

<div id="app" v-cloak>
    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div id="MainGrid" ref="mainGridRef"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="mainModalRef" id="MainModal" aria-hidden="true" tabindex="-1" data-bs-focus="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ state.mainTitle }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div v-if="state.sourceModule && methods.isEditableSource() && !state.viewMode && !state.deleteMode"
                         class="alert alert-info py-2">
                        {{ state.sourceModule === 'MaterialExport'
                            ? 'Only Description and Cash Category can be edited for a material export transaction.'
                            : 'Only Paid Amount, Description and Cash Category can be edited for a source-generated transaction.' }}
                    </div>
                    <input type="hidden" v-model="state.id" id="Id" name="Id" />
                    <form id="MainForm">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Transaction Info</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="TransactionDate">Transaction Date</label>
                                                <input id="TransactionDatePicker" ref="transactionDateRef" />
                                                <label class="text-danger">{{ state.errors.transactionDate }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="TransactionType">Transaction Type</label>
                                                <div id="TransactionTypeDropDown" ref="transactionTypeRef"></div>
                                                <label class="text-danger">{{ state.errors.transactionType }}</label>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="CashAccount">Cash Account</label>
                                                <div id="CashAccountDropDown" ref="cashAccountRef"></div>
                                                <label class="text-danger">{{ state.errors.cashAccountId }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="CashCategory">Cash Category</label>
                                                <div id="CashCategoryDropDown" ref="cashCategoryRef"></div>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="Partner">Partner</label>
                                                <div id="PartnerDropDown" ref="partnerRef"></div>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="Amount">Amount</label>
                                                <input id="AmountInput" ref="amountRef">
                                                <label class="text-danger">{{ state.errors.amount }}</label>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="PaidAmount">Paid Amount</label>
                                                <input id="PaidAmountInput" ref="paidAmountRef">
                                                <label class="text-danger">{{ state.errors.paidAmount }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label>Status</label>
                                                <div class="form-control-plaintext">
                                                    <span v-if="state.paidAmount >= state.amount && state.amount > 0" class="badge bg-success">Paid</span>
                                                    <span v-else-if="state.paidAmount > 0" class="badge bg-warning text-dark">Partially Paid</span>
                                                    <span v-else class="badge bg-secondary">Unpaid</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-12">
                                                <label for="Description">Description</label>
                                                <textarea v-model="state.description" id="Description" name="Description" class="form-control" rows="3"
                                                          v-bind:disabled="!methods.canEditRestrictedFields()"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="card mt-3" v-if="state.sourceModule === 'PurchaseOrder'">
                                    <div class="card-header"><h5>Cost Allocation Details</h5></div>
                                    <div class="card-body table-responsive">
                                        <div v-if="state.sourceDetailsLoading" class="text-center text-muted py-3">Loading source details...</div>
                                        <div v-else-if="state.sourceDetailsError" class="alert alert-danger mb-2">{{ state.sourceDetailsError }}</div>
                                        <table class="table table-sm table-bordered">
                                            <thead><tr><th>Product</th><th>Customer / Warehouse</th><th class="text-end">Quantity</th><th class="text-end">Unit Price</th><th class="text-end">Total</th></tr></thead>
                                            <tbody>
                                                <tr v-for="item in state.allocationDetails" v-bind:key="`${item.productName}-${item.customerName}`">
                                                    <td>{{ item.productName }}</td><td>{{ item.customerName }}</td>
                                                    <td class="text-end">{{ methods.formatNumber(item.quantity) }}</td><td class="text-end">{{ methods.formatMoney(item.unitPrice) }}</td><td class="text-end">{{ methods.formatMoney(item.total) }}</td>
                                                </tr>
                                                <tr v-if="!state.sourceDetailsLoading && state.allocationDetails.length === 0"><td colspan="5" class="text-center text-muted">No allocation details</td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="card mt-3" v-if="state.sourceModule === 'PurchaseOrder'">
                                    <div class="card-header"><h5>Payment History</h5></div>
                                    <div class="card-body table-responsive">
                                        <div v-if="state.sourceDetailsLoading" class="text-center text-muted py-3">Loading source details...</div>
                                        <div v-else-if="state.sourceDetailsError" class="alert alert-danger mb-2">{{ state.sourceDetailsError }}</div>
                                        <table class="table table-sm table-bordered">
                                            <thead><tr><th>Payment Date</th><th>Cash Account</th><th class="text-end">Amount</th><th>Description</th></tr></thead>
                                            <tbody>
                                                <tr v-for="payment in state.paymentHistory" v-bind:key="payment.id">
                                                    <td>{{ methods.formatDate(payment.paymentDate) }}</td><td>{{ payment.cashAccountName }}</td><td class="text-end">{{ methods.formatMoney(payment.amount) }}</td><td>{{ payment.description }}</td>
                                                </tr>
                                                <tr v-if="!state.sourceDetailsLoading && state.paymentHistory.length === 0"><td colspan="4" class="text-center text-muted">No payments</td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button v-if="!state.viewMode" type="button"
                            id="MainSaveButton"
                            class="btn"
                            v-bind:class="state.deleteMode ? 'btn-danger' : 'btn-primary'"
                            v-on:click="handler.handleSubmit"
                            v-bind:disabled="state.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting" role="status" aria-hidden="true"></span>
                        <span v-if="!state.isSubmitting">{{ state.deleteMode ? 'Delete' : 'Save' }}</span>
                        <span v-else>{{ state.deleteMode ? 'Deleting...' : 'Saving...' }}</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="transferModalRef" id="TransferModal" aria-hidden="true" tabindex="-1" data-bs-focus="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Fund Transfer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="TransferForm">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Transfer Info</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="TransferDate">Transfer Date</label>
                                                <input id="TransferDatePicker" ref="transferDateRef" />
                                                <label class="text-danger">{{ state.transfer.errors.transferDate }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="TransferAmount">Amount</label>
                                                <input ref="transferAmountRef">
                                                <label class="text-danger">{{ state.transfer.errors.amount }}</label>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="FromAccount">From Account</label>
                                                <div id="FromAccountDropDown" ref="fromAccountRef"></div>
                                                <label class="text-danger">{{ state.transfer.errors.fromCashAccountId }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="ToAccount">To Account</label>
                                                <div id="ToAccountDropDown" ref="toAccountRef"></div>
                                                <label class="text-danger">{{ state.transfer.errors.toCashAccountId }}</label>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-12">
                                                <label for="TransferDescription">Description</label>
                                                <textarea v-model="state.transfer.description" id="TransferDescription" name="TransferDescription" class="form-control" rows="3"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button"
                            id="TransferSaveButton"
                            class="btn btn-primary"
                            v-on:click="handler.handleTransferSubmit"
                            v-bind:disabled="state.transfer.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.transfer.isSubmitting" role="status" aria-hidden="true"></span>
                        <span v-if="!state.transfer.isSubmitting">Save</span>
                        <span v-else>Saving...</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/CashTransactions/CashTransactionList.cshtml.js"></script>
}
