@page
@{
    ViewData["Title"] = "Sales Order List";
}

<style>
    .payment-status-action {
        border: 0;
        background: transparent;
        padding: 0;
        font-size: 0.8125rem;
        font-weight: 600;
        line-height: 1.1;
        white-space: nowrap;
        cursor: pointer;
    }

    .payment-status-action-paid {
        color: #198754;
    }

    .payment-status-action-unpaid {
        color: #dc3545;
    }

    .payment-status-action-none {
        display: none;
    }

    .payment-status-action:hover {
        text-decoration: underline;
    }

    #MainModal .modal-xl {
        max-width: min(96vw, 1480px);
    }

    .sales-order-payment-popup {
        border-radius: 0.875rem !important;
        box-shadow: 0 1.25rem 3rem rgba(31, 45, 61, 0.22) !important;
    }

    .sales-order-payment-popup .swal2-title {
        padding-top: 1.5rem;
        font-size: 1.55rem;
    }

    .sales-order-payment-popup .swal2-html-container {
        margin: 1.25rem 2rem 0;
    }

    .payment-summary-box {
        min-height: 92px;
        padding: 0.875rem;
        border: 1px solid #e1e7ef;
        border-radius: 0.625rem;
        background: #f8fafc;
    }

    .payment-form-card {
        padding: 1rem;
        border: 1px solid #e1e7ef;
        border-radius: 0.75rem;
        background: #fff;
    }

    .payment-form-card .form-control {
        min-height: 44px;
        border-color: #cbd5e1;
        border-radius: 0.5rem;
    }

    .payment-form-card textarea.form-control {
        min-height: 76px;
    }

    @@media (max-width: 575.98px) {
        .sales-order-payment-popup .swal2-html-container {
            margin-right: 1rem;
            margin-left: 1rem;
        }
    }
</style>

<div id="app" v-cloak>
    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div id="MainGrid" ref="mainGridRef"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="mainModalRef" id="MainModal" aria-hidden="true" tabindex="-1" data-bs-focus="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ state.mainTitle }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" v-model="state.id" id="Id" name="Id" />
                    <fieldset :disabled="state.isViewMode">
                        <form id="MainForm">
                            <div class="row">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Main Info</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="OrderDate">Ngày đặt hàng</label>
                                                <input ref="orderDateRef" />
                                                <label class="text-danger">{{ state.errors.orderDate }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="Number">Số đơn</label>
                                                <input ref="numberRef" v-model="state.number" readonly>
                                            </div>
                                        </div>
                                         <div class="row mb-2">
                                             <div class="col-md-6">
                                                 <label for="CustomerId">Khách hàng</label>
                                                 <div class="quick-add-wrapper">
                                                     <div ref="customerIdRef"></div>
                                                     <button type="button" class="btn btn-sm btn-outline-primary quick-add-btn"
                                                             v-on:click="handler.quickAddCustomer" title="Thêm nhanh KH">
                                                         <i class="fas fa-plus"></i>
                                                     </button>
                                                 </div>
                                                 <label class="text-danger">{{ state.errors.customerId }}</label>
                                             </div>
                                             <div class="col-md-6">
                                                 <label for="SalesType">Loại xuất bán</label>
                                                 <div ref="salesTypeRef"></div>
                                                 <label class="text-danger">{{ state.errors.salesType }}</label>
                                             </div>
                                         </div>
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="OrderStatus">Trạng thái</label>
                                                <div ref="orderStatusRef"></div>
                                                <label class="text-danger">{{ state.errors.orderStatus }}</label>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-12">
                                                <label for="Description">Mô tả</label>
                                                <textarea class="form-control" rows="3" v-model="state.description"></textarea>
                                                <label class="text-danger">{{ state.errors.description }}</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                    <div id="ComplexDiv" :style="{ display: state.showComplexDiv ? 'block' : 'none' }">
                        <div class="row mt-3">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Sales Order Item</h5>
                                    </div>
                                    <div class="card-body">
                                        <p class="text-muted mb-3">
                                            Chọn hàng hóa và kho còn tồn; hệ thống sẽ tự điền đơn giá theo loại xuất đã chọn.
                                        </p>
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="grid-container">
                                                    <div id="SecondaryGrid" ref="secondaryGridRef"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4">
                            <div class="col-md-12">
                                <div class="card shadow-sm">
                                    <div class="card-header text-white">
                                        <h5 class="mb-0">Payment Summary</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row justify-content-end">
                                            <div class="col-md-6">
                                                <div class="d-flex justify-content-between py-2 border-bottom">
                                                    <span class="fw-bold">Subtotal</span>
                                                    <span id="SubTotalAmount">{{ state.subTotalAmount }}</span>
                                                </div>
                                                <div class="d-flex justify-content-between py-2 border-bottom">
                                                    <span class="fw-bold">Tax</span>
                                                    <span id="TaxAmount">{{ state.taxAmount }}</span>
                                                </div>
                                                <div class="d-flex justify-content-between py-2">
                                                    <span class="fw-bold">Total Amount</span>
                                                    <span id="TotalAmount" class="fw-bold text-success">{{ state.totalAmount }}</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button"
                            v-if="!state.isViewMode"
                            id="MainSaveButton"
                            class="btn"
                            v-bind:class="state.deleteMode ? 'btn-danger' : 'btn-primary'"
                            v-on:click="handler.handleSubmit"
                            v-bind:disabled="state.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting" role="status" aria-hidden="true"></span>
                        <span v-if="!state.isSubmitting">{{ state.deleteMode ? 'Xóa' : 'Lưu' }}</span>
                        <span v-else>{{ state.deleteMode ? 'Đang xóa...' : 'Đang lưu...' }}</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/lib/indotalent/product-dropdown-search.js" asp-append-version="true"></script>
    <script src="~/lib/indotalent/sales-order-item-editor.js" asp-append-version="true"></script>
    <script src="~/FrontEnd/Pages/SalesOrders/SalesOrderList.cshtml.js" asp-append-version="true"></script>
}
