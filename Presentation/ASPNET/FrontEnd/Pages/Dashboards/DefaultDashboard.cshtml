@page
@{
    ViewData["Title"] = "Operations Overview";
}

<style>
    .dashboard-hero { background: linear-gradient(135deg, #0b5cab, #168aad); color: #fff; border-radius: 16px; padding: 24px; }
    .dashboard-kpi { border: 0; border-radius: 14px; box-shadow: 0 5px 20px rgba(29, 53, 87, .08); height: 100%; }
    .dashboard-kpi .icon { width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center; font-size: 20px; }
    .dashboard-panel { border: 0; border-radius: 14px; box-shadow: 0 5px 20px rgba(29, 53, 87, .08); }
    .dashboard-value { font-size: 1.35rem; font-weight: 700; color: #203040; overflow-wrap: anywhere; }
</style>

<div id="app" v-cloak>
    <div class="form-card" id="formcard">
        <div class="container-fluid py-4 px-4">
            <section class="dashboard-hero d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                    <div class="text-white-50 small">Warehouse Management System</div>
                    <h2 class="mb-1">Operations Overview</h2>
                    <div class="text-white-50">Sales, purchasing, cash flow and inventory in one place.</div>
                </div>
                <div class="text-end">
                    <button type="button" class="btn btn-light" v-on:click="methods.loadDashboard" v-bind:disabled="state.loading">
                        <i class="fas fa-sync-alt me-2" v-bind:class="{ 'fa-spin': state.loading }"></i>Refresh
                    </button>
                    <div class="small text-white-50 mt-2" v-if="state.lastUpdated">Updated {{ state.lastUpdated }}</div>
                </div>
            </section>

            <div v-if="state.pageError" class="alert alert-danger">{{ state.pageError }}</div>

            <div v-if="state.errors.cards" class="alert alert-warning d-flex justify-content-between align-items-center">
                <span>{{ state.errors.cards }}</span>
                <button type="button" class="btn btn-sm btn-outline-dark" v-on:click="methods.loadCards">Retry</button>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-xl-3" v-for="card in methods.kpiCards()" v-bind:key="card.label">
                    <a v-bind:href="card.href" class="text-decoration-none">
                        <div class="card dashboard-kpi">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="icon" v-bind:class="card.iconClass"><i v-bind:class="card.icon"></i></div>
                                <div class="min-w-0">
                                    <div class="text-muted small">{{ card.label }}</div>
                                    <div class="dashboard-value">{{ card.value }}</div>
                                    <div class="text-muted small">{{ card.note }}</div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-xl-6">
                    <div class="card dashboard-panel h-100">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                            <h5 class="mb-0">Recent Sales Orders</h5><a href="/SalesOrders/SalesOrderList">View All</a>
                        </div>
                        <div class="card-body">
                            <div v-if="state.errors.sales" class="alert alert-warning">
                                {{ state.errors.sales }}
                                <button type="button" class="btn btn-sm btn-outline-dark ms-2" v-on:click="methods.loadSales">Retry</button>
                            </div>
                            <div ref="salesOrderGridRef"></div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-6">
                    <div class="card dashboard-panel h-100">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                            <h5 class="mb-0">Recent Purchase Orders</h5><a href="/PurchaseOrders/PurchaseOrderList">View All</a>
                        </div>
                        <div class="card-body">
                            <div v-if="state.errors.purchase" class="alert alert-warning">
                                {{ state.errors.purchase }}
                                <button type="button" class="btn btn-sm btn-outline-dark ms-2" v-on:click="methods.loadPurchase">Retry</button>
                            </div>
                            <div ref="purchaseOrderGridRef"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-xl-7">
                    <div class="card dashboard-panel h-100">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                            <h5 class="mb-0">Latest Inventory Movements</h5><a href="/TransactionReports/TransactionReportList">View All</a>
                        </div>
                        <div class="card-body">
                            <div v-if="state.errors.inventory" class="alert alert-warning">
                                {{ state.errors.inventory }}
                                <button type="button" class="btn btn-sm btn-outline-dark ms-2" v-on:click="methods.loadInventory">Retry</button>
                            </div>
                            <div ref="inventoryTransactionGridRef"></div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-5">
                    <div class="card dashboard-panel h-100">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                            <h5 class="mb-0">Stock by Warehouse</h5><a href="/StockReports/StockReportList">View Stock</a>
                        </div>
                        <div class="card-body">
                            <div v-if="state.errors.inventory" class="alert alert-warning">{{ state.errors.inventory }}</div>
                            <div ref="stockChartRef"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="DashboardBootError" class="alert alert-danger m-4" style="display:none">
    Dashboard could not be initialized. Reload the page and check the browser Console/Network details.
</div>

@section scripts {
    @{
        var dashboardScriptPath = System.IO.Path.Combine(
            System.IO.Directory.GetCurrentDirectory(),
            "FrontEnd", "Pages", "Dashboards", "DefaultDashboard.cshtml.js");
        var dashboardScriptVersion = System.IO.File.Exists(dashboardScriptPath)
            ? System.IO.File.GetLastWriteTimeUtc(dashboardScriptPath).Ticks
            : DateTime.UtcNow.Ticks;
    }
    <script>
        window.showDashboardBootError = function () {
            const errorPanel = document.getElementById('DashboardBootError');
            if (errorPanel) errorPanel.style.display = 'block';
        };
        window.setTimeout(function () {
            const dashboardApp = document.getElementById('app');
            if (dashboardApp?.hasAttribute('v-cloak')) window.showDashboardBootError();
        }, 5000);
    </script>
    <script src="~/FrontEnd/Pages/Dashboards/DefaultDashboard.cshtml.js?v=@dashboardScriptVersion"
            onerror="window.showDashboardBootError()"></script>
}
