@page
@{
    ViewData["Title"] = "Warranty Lookup";
}

<div id="app" v-cloak>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Warranty Lookup</h3>
                </div>
                <div class="card-body">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-8">
                            <label class="form-label">Serial nội bộ, serial nhà sản xuất, số đơn bán, khách hàng hoặc số điện thoại</label>
                            <input ref="searchTextRef" type="text">
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-primary" v-on:click="methods.lookupWarranty">
                                Search
                            </button>
                            <button type="button" class="btn btn-outline-secondary ms-2" v-on:click="methods.clearSearch">
                                Clear
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid-container mt-3">
                <div id="MainGrid" ref="mainGridRef"></div>
            </div>

            <div class="grid-container mt-3" v-show="state.selectedSerialNumber">
                <h5 class="mb-2"><span>Movement History:</span> {{ state.selectedSerialNumber }}</h5>
                <div id="MovementGrid" ref="movementGridRef"></div>
            </div>
        </div>
    </div>

    <!-- Document Modal -->
    <div class="modal fade" ref="documentModalRef" id="DocumentModal" aria-hidden="true" tabindex="-1" data-bs-focus="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ state.docTitle }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" v-on:click="methods.closeDocumentModal"></button>
                </div>
                <div class="modal-body bg-light">
                    <!-- Loading Spinner -->
                    <div v-if="state.docLoading" class="text-center p-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                    
                    <div v-if="!state.docLoading && state.docData && state.docType === 'CostAllocation'" class="container-fluid py-2">
                        <div class="card shadow-sm border-0">
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-4"><label class="form-label text-muted small">Đơn mua hàng</label><div class="fw-bold">{{ state.docData.purchaseOrderNumber || '—' }}</div></div>
                                    <div class="col-md-4"><label class="form-label text-muted small">Công trình / Khách hàng</label><div class="fw-bold">{{ state.docData.allocationCustomerName || '—' }}</div></div>
                                    <div class="col-md-4"><label class="form-label text-muted small">Ngày giao dịch</label><div class="fw-bold">{{ methods.formatDateTime(state.docData.movementDate) }}</div></div>
                                    <div class="col-md-4"><label class="form-label text-muted small">Hàng hóa</label><div>{{ state.docData.allocationProductName || '—' }}</div></div>
                                    <div class="col-md-4"><label class="form-label text-muted small">Kho</label><div>{{ state.docData.allocationWarehouseName || '—' }}</div></div>
                                    <div class="col-md-4"><label class="form-label text-muted small">Số lượng</label><div>{{ methods.formatNumber(state.docData.allocationQuantity) }}</div></div>
                                    <div class="col-md-4"><label class="form-label text-muted small">Đơn giá</label><div>{{ methods.formatNumber(state.docData.allocationUnitPrice) }}</div></div>
                                    <div class="col-md-4"><label class="form-label text-muted small">Thành tiền</label><div class="fw-bold">{{ methods.formatNumber(state.docData.allocationTotal) }}</div></div>
                                </div>
                            </div>
                            <div class="card-footer bg-white text-end" v-if="state.docData.purchaseOrderId">
                                <button type="button" class="btn btn-outline-primary" v-on:click="methods.openDocumentView('PurchaseOrder', state.docData.purchaseOrderId)">Xem đơn mua hàng</button>
                            </div>
                        </div>
                    </div>

                    <div v-else-if="!state.docLoading && state.docData" class="container-fluid py-2">
                        <div class="card mb-3 shadow-sm border-0">
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label text-muted small mb-1">Document Number</label>
                                        <div class="fw-bold">{{ state.docData.number }}</div>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label text-muted small mb-1">Date</label>
                                        <div class="fw-bold">{{ methods.formatDate(state.docData.orderDate) }}</div>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label text-muted small mb-1">{{ state.docType === 'PurchaseOrder' ? 'Vendor' : 'Customer' }}</label>
                                        <div class="fw-bold">{{ state.docData.vendor?.name || state.docData.customer?.name }}</div>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label text-muted small mb-1">Status</label>
                                        <div class="fw-bold">
                                            <span class="badge bg-secondary">{{ methods.formatStatus(state.docData.orderStatus) }}</span>
                                        </div>
                                    </div>
                                    <div class="col-12" v-if="state.docData.description">
                                        <label class="form-label text-muted small mb-1">Description</label>
                                        <div>{{ state.docData.description }}</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-white border-bottom-0 pt-3">
                                <h6 class="mb-0 fw-bold">Items</h6>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover table-striped mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="ps-3">Product</th>
                                                <th>Warehouse</th>
                                                <th class="text-end">Qty</th>
                                                <th class="text-end">Price</th>
                                                <th class="text-end pe-3">Total</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr v-for="item in state.docItems" :key="item.id">
                                                <td class="ps-3">
                                                    <div class="fw-bold">{{ item.product?.name }}</div>
                                                    <div class="small text-muted">{{ item.product?.number }}</div>
                                                </td>
                                                <td class="align-middle">{{ item.warehouse?.name }}</td>
                                                <td class="text-end align-middle">{{ methods.formatNumber(item.quantity) }}</td>
                                                <td class="text-end align-middle">{{ methods.formatNumber(item.unitPrice) }}</td>
                                                <td class="text-end fw-bold pe-3 align-middle">{{ methods.formatNumber(item.quantity * item.unitPrice) }}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="card-footer bg-white text-end py-3">
                                <div class="row justify-content-end">
                                    <div class="col-md-4 pe-3">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted">Subtotal:</span>
                                            <span>{{ methods.formatNumber(state.docData.beforeTaxAmount) }}</span>
                                        </div>
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted">Tax:</span>
                                            <span>{{ methods.formatNumber(state.docData.taxAmount) }}</span>
                                        </div>
                                        <div class="d-flex justify-content-between mt-3 pt-2 border-top">
                                            <span class="fw-bold">Total:</span>
                                            <span class="fw-bold text-success fs-5">{{ methods.formatNumber(state.docData.afterTaxAmount) }}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" v-on:click="methods.closeDocumentModal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/WarrantyLookups/WarrantyLookup.cshtml.js" asp-append-version="true"></script>
}
