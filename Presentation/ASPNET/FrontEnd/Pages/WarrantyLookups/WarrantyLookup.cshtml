@page
@{
    ViewData["Title"] = "Warranty Lookup";
}

<div id="app" v-cloak>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Warranty Lookup</h3>
                </div>
                <div class="card-body">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-8">
                            <label class="form-label">Serial number, SO number, or customer phone</label>
                            <div ref="searchTextRef"></div>
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-primary" v-on:click="methods.lookupWarranty">
                                Search
                            </button>
                            <button type="button" class="btn btn-outline-secondary ms-2" v-on:click="methods.clearSearch">
                                Clear
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid-container mt-3">
                <div id="MainGrid" ref="mainGridRef"></div>
            </div>

            <div class="grid-container mt-3" v-show="state.selectedSerialNumber">
                <h5 class="mb-2">Movement History: {{ state.selectedSerialNumber }}</h5>
                <div id="MovementGrid" ref="movementGridRef"></div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/WarrantyLookups/WarrantyLookup.cshtml.js"></script>
}
