@page
@{
    ViewData["Title"] = "Vendor Debt Report";
}

<div id="app" v-cloak>
    <div class="row">
        <div class="col-12">
            <div class="alert alert-info">
                Báo cáo tổng hợp công nợ nhà cung cấp. Tổng tiền mua từ đơn mua hàng đã xác nhận, trừ đi tổng đã thanh toán (giao dịch chi đã xác nhận).
            </div>
            <div class="grid-container">
                <div id="MainGrid" ref="mainGridRef"></div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/VendorDebtReports/VendorDebtReportList.cshtml.js"></script>
}
