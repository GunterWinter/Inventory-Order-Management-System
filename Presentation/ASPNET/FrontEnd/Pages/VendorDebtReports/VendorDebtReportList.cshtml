@page
@{
    ViewData["Title"] = "Debt Report";
}

<div id="app" v-cloak>
    <div class="row"><div class="col-12">
        <h3>Debt Report</h3>
        <div class="btn-group mb-3" role="group">
            <button class="btn" v-bind:class="state.partyType === 'Customer' ? 'btn-primary' : 'btn-outline-primary'" v-on:click="handler.selectParty('Customer')">Customers</button>
            <button class="btn" v-bind:class="state.partyType === 'Vendor' ? 'btn-primary' : 'btn-outline-primary'" v-on:click="handler.selectParty('Vendor')">Vendors</button>
        </div>
        <div class="grid-container"><div id="MainGrid" ref="mainGridRef"></div></div>
    </div></div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/VendorDebtReports/VendorDebtReportList.cshtml.js" asp-append-version="true"></script>
}
