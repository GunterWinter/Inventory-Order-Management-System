@page
@{
    ViewData["Title"] = "Danh sách Xuất vật tư";
}

<div id="app" v-cloak>
    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div id="MainGrid" ref="mainGridRef"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="mainModalRef" id="MainModal" aria-hidden="true" tabindex="-1" data-bs-focus="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ state.mainTitle }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" v-model="state.id" id="Id" name="Id" />
                    <form>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Thông tin chính</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="MaterialExportDate">Ngày xuất</label>
                                                <input ref="MaterialExportDateRef">
                                                <label class="text-danger">{{ state.errors.MaterialExportDate }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="Number">Mã số</label>
                                                <input ref="numberRef" v-model="state.number" readonly>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="WarehouseId">Kho</label>
                                                <div ref="warehouseIdRef"></div>
                                                <label class="text-danger">{{ state.errors.warehouseId }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="CustomerId">Khách hàng</label>
                                                <div class="quick-add-wrapper">
                                                    <div ref="customerIdRef"></div>
                                                    <button type="button" class="btn btn-sm btn-outline-primary quick-add-btn"
                                                            v-on:click="handler.quickAddCustomer" title="Thêm nhanh KH">
                                                        <i class="fas fa-plus"></i>
                                                    </button>
                                                </div>
                                                <label class="text-danger">{{ state.errors.customerId }}</label>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="Status">Trạng thái</label>
                                                <div ref="statusRef"></div>
                                                <label class="text-danger">{{ state.errors.status }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="Description">Ghi chú</label>
                                                <textarea class="form-control" rows="3" v-model="state.description"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                    <div id="ComplexDiv" :style="{ display: state.showComplexDiv ? 'block' : 'none' }">
                        <div class="row mt-3">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Chi tiết vật tư</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="grid-container">
                                                    <div id="SecondaryGrid" ref="secondaryGridRef"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4">
                            <div class="col-md-12">
                                <div class="card shadow-sm">
                                    <div class="card-header text-white">
                                        <h5 class="mb-0">Tổng cộng</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="mb-3">
                                                    <label class="form-label text-muted">Tổng số lượng xuất</label>
                                                    <div class="h4 text-primary fw-bold">{{ state.totalMovementFormatted }}</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button v-if="!state.isViewMode" type="button" class="btn btn-primary" v-on:click="handler.handleSubmit"
                            :disabled="state.isSubmitting">
                        <span v-if="state.isSubmitting" class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        {{ state.isSubmitting ? 'Đang xử lý...' : (state.deleteMode ? 'Xóa' : 'Lưu') }}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/FrontEnd/Pages/MaterialExports/MaterialExportList.cshtml.js" asp-append-version="true"></script>
}
