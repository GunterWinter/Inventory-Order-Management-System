@page
@{
    ViewData["Title"] = "Purchase Order List";
}

<style>
    .payment-status-action {
        border: 0;
        background: transparent;
        padding: 0;
        font-size: 0.8125rem;
        font-weight: 600;
        line-height: 1.1;
        white-space: nowrap;
        cursor: pointer;
    }

    .payment-status-action-paid {
        color: #198754;
    }

    .payment-status-action-unpaid {
        color: #dc3545;
    }

    .payment-status-action-none {
        display: none;
    }

    .payment-status-action:hover {
        text-decoration: underline;
    }

    #MainModal .modal-xl {
        max-width: min(96vw, 1480px);
    }

    .purchase-order-payment-popup {
        border-radius: 0.875rem !important;
        box-shadow: 0 1.25rem 3rem rgba(31, 45, 61, 0.22) !important;
    }

    .purchase-order-payment-popup .swal2-title {
        padding-top: 1.5rem;
        font-size: 1.55rem;
    }

    .purchase-order-payment-popup .swal2-html-container {
        margin: 1.25rem 2rem 0;
    }

    .purchase-payment-summary {
        padding: 0.875rem 1rem;
        border: 1px solid #e1e7ef;
        border-radius: 0.625rem;
        background: #f8fafc;
    }

    .purchase-payment-summary__row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.4rem 0;
    }

    .purchase-payment-summary__row + .purchase-payment-summary__row {
        border-top: 1px solid #e7ecf2;
    }

    .purchase-payment-form {
        padding: 1rem;
        border: 1px solid #e1e7ef;
        border-radius: 0.75rem;
        background: #fff;
    }

    .purchase-payment-form .form-control {
        min-height: 44px;
        border-color: #cbd5e1;
        border-radius: 0.5rem;
    }

    @@media (max-width: 575.98px) {
        .purchase-order-payment-popup .swal2-html-container {
            margin-right: 1rem;
            margin-left: 1rem;
        }
    }
</style>

<div id="app" v-cloak>
    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div id="MainGrid" ref="mainGridRef"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="mainModalRef" id="MainModal" aria-hidden="true" tabindex="-1" data-bs-focus="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ state.mainTitle }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" v-model="state.id" id="Id" name="Id" />
                    <fieldset :disabled="state.isViewMode">
                        <form id="MainForm">
                            <div class="row">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Main Info</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="OrderDate">Order Date</label>
                                                <input ref="orderDateRef" />
                                                <label class="text-danger">{{ state.errors.orderDate }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="Number">Number</label>
                                                <input ref="numberRef" v-model="state.number" readonly>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="VendorId">Vendor</label>
                                                <div class="quick-add-wrapper">
                                                    <div ref="vendorIdRef"></div>
                                                    <button type="button" class="btn btn-sm btn-outline-primary quick-add-btn"
                                                            v-on:click="handler.quickAddVendor" title="Quick Add Vendor">
                                                        <i class="fas fa-plus"></i>
                                                    </button>
                                                </div>
                                                <label class="text-danger">{{ state.errors.vendorId }}</label>
                                            </div>
                                        </div>
                                          <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="OrderStatus">Status</label>
                                                <div ref="orderStatusRef"></div>
                                                <label class="text-danger">{{ state.errors.orderStatus }}</label>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <div class="col-md-12">
                                                <label for="Description">Description</label>
                                                <textarea class="form-control" rows="3" v-model="state.description"></textarea>
                                                <label class="text-danger">{{ state.errors.description }}</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                    <div id="ComplexDiv" :style="{ display: state.showComplexDiv ? 'block' : 'none' }">
                        <div class="row mt-3">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Purchase Order Details</h5>
                                    </div>
                                    <div class="card-body">
                                        <p class="text-muted mb-3">
                                            Add the products, warehouses, quantities, taxes and serial details for this purchase order.
                                        </p>
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="grid-container">
                                                    <div id="SecondaryGrid" ref="secondaryGridRef"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4">
                            <div class="col-md-12">
                                <div class="card shadow-sm">
                                    <div class="card-header text-white">
                                        <h5 class="mb-0">Payment Summary</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row justify-content-end">
                                            <div class="col-md-6">
                                                <div class="d-flex justify-content-between py-2 border-bottom">
                                                    <span class="fw-bold">Subtotal</span>
                                                    <span id="SubTotalAmount">{{ state.subTotalAmount }}</span>
                                                </div>
                                                <div class="d-flex justify-content-between py-2 border-bottom">
                                                    <span class="fw-bold">Tax</span>
                                                    <span id="TaxAmount">{{ state.taxAmount }}</span>
                                                </div>
                                                <div class="d-flex justify-content-between py-2">
                                                    <span class="fw-bold">Total Amount</span>
                                                    <span id="TotalAmount" class="fw-bold text-success">{{ state.totalAmount }}</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button"
                            v-if="!state.isViewMode"
                            id="MainSaveButton"
                            class="btn"
                            v-bind:class="state.deleteMode ? 'btn-danger' : 'btn-primary'"
                            v-on:click="handler.handleSubmit"
                            v-bind:disabled="state.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting" role="status" aria-hidden="true"></span>
                        <span v-if="!state.isSubmitting">{{ state.deleteMode ? 'Delete' : 'Save' }}</span>
                        <span v-else>{{ state.deleteMode ? 'Deleting...' : 'Saving...' }}</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="costAllocationModalRef" id="CostAllocationModal" aria-hidden="true" tabindex="-1" data-bs-focus="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-pie-chart me-2"></i>Cost Allocation</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <div class="text-muted">
                                <small><span>Selected</span> <strong>{{ state.costAllocationSelectedItems.length }}</strong> <span>products for cost allocation. Add multiple rows when one product is allocated to multiple customers.</span></small>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="card">
                                <div class="card-header">
                                    <h6 class="mb-0">Cost Allocation Details</h6>
                                </div>
                                <div class="card-body p-0">
                                    <div class="grid-container">
                                        <div id="CostAllocationPreviewGrid" ref="costAllocationPreviewGridRef"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button"
                            id="CostAllocationSaveButton"
                            class="btn btn-primary"
                            v-on:click="handler.handleCostAllocationSubmit"
                            v-bind:disabled="state.isCostAllocationSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.isCostAllocationSubmitting" role="status" aria-hidden="true"></span>
                        <span v-if="!state.isCostAllocationSubmitting">Confirm Allocation</span>
                        <span v-else>Processing...</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <script type="text/x-template" id="detailtemplate">
        <div class="allocation-detail-grid" style="margin: 10px;"></div>
    </script>
</div>

@section Scripts {
    <script src="~/FrontEnd/Pages/PurchaseOrders/PurchaseOrderList.cshtml.js" asp-append-version="true"></script>
}
