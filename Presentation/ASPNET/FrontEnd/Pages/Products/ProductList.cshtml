@page
@{
    ViewData["Title"] = "Product List";
}
<div id="app" v-cloak>
    <div class="row">
        <div class="col-12">
            <div class="grid-container">
                <div id="MainGrid" ref="mainGridRef"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" ref="mainModalRef" id="MainModal" aria-hidden="true" tabindex="-1" data-bs-focus="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ state.mainTitle }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" v-model="state.id" id="Id" name="Id" />
                    <form id="MainForm">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Main Info</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="Name">Name</label>
                                                <input ref="nameRef" v-model="state.name">
                                                <label class="text-danger">{{ state.errors.name }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="Number">Number (Mã HT)</label>
                                                <input ref="numberRef" v-model="state.number" readonly>
                                            </div>
                                        </div>
                                        
                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="ReferenceCode">Reference Code (Mã tùy chỉnh)</label>
                                                <input ref="referenceCodeRef" v-model="state.referenceCode" class="form-control" placeholder="Nhập mã nội bộ/SKU...">
                                                <label class="text-danger">{{ state.errors.referenceCode }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="UnitPrice">Unit Price</label>
                                                <input ref="unitPriceRef" v-model="state.unitPrice">
                                                <label class="text-danger">{{ state.errors.unitPrice }}</label>
                                            </div>
                                        </div>

                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="UnitMeasureId">Unit Measure</label>
                                                <div ref="unitMeasureIdRef"></div>
                                                <label class="text-danger">{{ state.errors.unitMeasureId }}</label>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="ProductGroupId">Product Group</label>
                                                <div ref="productGroupIdRef"></div>
                                                <label class="text-danger">{{ state.errors.productGroupId }}</label>
                                            </div>
                                        </div>

                                        <div class="row mb-2">
                                            <div class="col-md-6">
                                                <label for="DefaultWarehouseId">Warehouse</label>
                                                <div ref="defaultWarehouseIdRef"></div>
                                            </div>
                                            <div class="col-md-6">
                                                <label for="DefaultWarrantyMonths">Warranty Months</label>
                                                <input ref="defaultWarrantyMonthsRef" v-model="state.defaultWarrantyMonths">
                                                <label class="text-danger">{{ state.errors.defaultWarrantyMonths }}</label>
                                            </div>
                                        </div>

                                        <div class="row mb-2">
                                            <div class="col-md-12">
                                                <div class="form-check mt-2">
                                                    <input v-model="state.physical" id="Physical" name="Physical" type="checkbox" class="form-check-input">
                                                    <label for="Physical" class="form-check-label">Is Physical Product?</label>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row mb-2" v-if="state.physical">
                                            <div class="col-md-12">
                                                <label>Kiểu quản lý mã thiết bị</label>
                                                <div class="border rounded p-3">
                                                    <div class="form-check">
                                                        <input class="form-check-input"
                                                               type="radio"
                                                               id="SerialTrackingInternalAuto"
                                                               name="SerialTrackingMode"
                                                               v-model.number="state.serialTrackingMode"
                                                               v-bind:value="1">
                                                        <label class="form-check-label" for="SerialTrackingInternalAuto">Tự sinh mã nội bộ</label>
                                                    </div>
                                                    <div class="mt-2 ms-4" v-if="state.serialTrackingMode === 1">
                                                        <label for="InternalSerialFixedCode">Mã cố định</label>
                                                        <input id="InternalSerialFixedCode"
                                                               class="form-control"
                                                               v-model="state.internalSerialFixedCode"
                                                               v-on:input="handler.handleInternalSerialFixedCodeInput"
                                                               maxlength="4"
                                                               placeholder="CAM">
                                                        <small class="text-muted">Ví dụ mã tự sinh: {{ getInternalSerialPreview() }}</small>
                                                        <label class="text-danger d-block">{{ state.errors.internalSerialFixedCode }}</label>
                                                    </div>
                                                    <div class="form-check mt-3">
                                                        <input class="form-check-input"
                                                               type="radio"
                                                               id="SerialTrackingManufacturer"
                                                               name="SerialTrackingMode"
                                                               v-bind:value="2"
                                                               disabled>
                                                        <label class="form-check-label" for="SerialTrackingManufacturer">
                                                            Nhập serial hãng <span class="badge bg-secondary">Đang phát triển</span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row mb-2">
                                            <div class="col-12">
                                                <label for="Description">Description</label>
                                                <textarea v-model="state.description" id="Description" name="Description" class="form-control" rows="3"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button"
                            id="MainSaveButton"
                            class="btn"
                            v-bind:class="state.deleteMode ? 'btn-danger' : 'btn-primary'"
                            v-on:click="handler.handleSubmit"
                            v-bind:disabled="state.isSubmitting">
                        <span class="spinner-border spinner-border-sm me-2" v-if="state.isSubmitting" role="status" aria-hidden="true"></span>
                        <span v-if="!state.isSubmitting">{{ state.deleteMode ? 'Delete' : 'Save' }}</span>
                        <span v-else>{{ state.deleteMode ? 'Deleting...' : 'Saving...' }}</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/FrontEnd/Pages/Products/ProductList.cshtml.js"></script>
}
