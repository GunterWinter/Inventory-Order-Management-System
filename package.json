{
  "name": "inventory-order-management-system-tests",
  "private": true,
  "scripts": {
    "test:js": "node --test Tests/JavaScript/*.test.js",
    "test:browser": "node Tests/browser_dashboard_materialexport_smoke.js",
    "test:browser:documents": "node Tests/browser_document_modal_controls_smoke.js",
    "test:browser:sales-items": "playwright test Tests/Browser/product-purchase-sales.spec.js Tests/Browser/quick-add-product.spec.js",
    "test:browser:gate:purchase-sales": "npm run test:browser:sales-items",
    "test:browser:cash": "node Tests/browser_cash_category_report_smoke.js",
    "test:browser:ui": "playwright test Tests/Browser/responsive-shell.spec.js",
    "test:browser:files": "node Tests/browser_file_workflows_smoke.js",
    "test:browser:business": "playwright test Tests/Browser/full-menu-business-regression.spec.js",
    "test:browser:playwright": "playwright test",
    "test:browser:all": "npm run test:browser && npm run test:browser:documents && npm run test:browser:cash && npm run test:browser:files && npm run test:browser:playwright",
    "test:browser:isolated": "powershell -NoProfile -ExecutionPolicy Bypass -File Tests/run-browser-business-regression.ps1"
  },
  "devDependencies": {
    "@playwright/test": "1.54.2",
    "playwright": "1.54.2"
  }
}
